# Скопируйте в .env и подставьте значения.

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=interview_qa

# Embeddings
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DIM=768

# DOCX-источник
INTERVIEW_DOCX_PATH=./Топ вопросов на собеседовании Python.docx
# INTERVIEW_DOCX_PATH=D:\Yandex.Disk\Собесы\Топ вопросов на собеседовании Python.docx
INGEST_STATE_PATH=data/interview_ingest_state.json

# Ollama LLM
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SEC=120

# Docker Compose: путь к docx на хосте
# DOCX_SOURCE_PATH_HOST=D:\Yandex.Disk\Собесы\Топ вопросов на собеседовании Python.docx
DOCX_SOURCE_PATH_HOST=./Топ вопросов на собеседовании Python.docx

# Системный дизайн (LangGraph)
# postgres — состояние интервью персистентно; memory — в рамках процесса (фолбэк при недоступной БД)
DESIGN_CHECKPOINTER=postgres
DESIGN_GRAPH_MAX_CACHE=64

# LangSmith (трассировка LLM-вызовов)
# ВКЛ. трассировку: LANGSMITH_TRACING=true + заданный API-ключ.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=tech-interview-agent
# Ключ API LangSmith (обязателен, если включена трассировка):
LANGSMITH_API_KEY=
# Self-hosted LangSmith endpoint (если используете свой): http://localhost:1984
# LANGSMITH_ENDPOINT=

# LLM провайдер (генерация): ollama | opencode
# opencode = OpenCode Zen. Если выбран ollama, но она не запущена —
# генерация автоматически переключится на Zen.
LLM_PROVIDER=ollama

# OpenCode Zen (https://opencode.ai/zen/v1)
# ВАЖНО: у Zen нет эндпоинта эмбеддингов (/embeddings → 404),
# поэтому эмбеддинги для RAG всегда считаются в Ollama.
# Большинство free-tier моделей Zen (big-pickle, nemotron-*, mimo-*,
# muse-spark-*, jev-*-free) работают ТОЛЬКО изнутри OpenCode:
# при прямом API-вызове возвращается 403 FreeTierError.
# Проверенная рабочая бесплатная модель для прямого API: space-bunny-free.
# Платные модели (например glm-5.3-flash) требуют пополнения баланса (402).
OPENCODE_KEY=
OPENCODE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=space-bunny-free
OPENCODE_TIMEOUT_SEC=120
# Глубина размышлений reasoning-моделей: low | medium | high (пусто — не слать).
# low сокращает ответ с 14.1s/908 thinking-токенов до 4.1s/33 и убирает пустые ответы.
OPENCODE_REASONING_EFFORT=low
