# Скопируйте в .env и подставьте значения.

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=interview_qa

# Embeddings
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DIM=768

# DOCX-источник
INTERVIEW_DOCX_PATH=./Топ вопросов на собеседовании Python.docx
# INTERVIEW_DOCX_PATH=D:\Yandex.Disk\Собесы\Топ вопросов на собеседовании Python.docx
INGEST_STATE_PATH=data/interview_ingest_state.json

# Ollama LLM
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SEC=120

# Docker Compose: путь к docx на хосте
# DOCX_SOURCE_PATH_HOST=D:\Yandex.Disk\Собесы\Топ вопросов на собеседовании Python.docx
DOCX_SOURCE_PATH_HOST=./Топ вопросов на собеседовании Python.docx

# Системный дизайн (LangGraph)
# postgres — состояние интервью персистентно; memory — в рамках процесса (фолбэк при недоступной БД)
DESIGN_CHECKPOINTER=postgres
DESIGN_GRAPH_MAX_CACHE=64

# LangSmith (трассировка LLM-вызовов)
# ВКЛ. трассировку: LANGSMITH_TRACING=true + заданный API-ключ.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=tech-interview-agent
# Ключ API LangSmith (обязателен, если включена трассировка):
LANGSMITH_API_KEY=
# Self-hosted LangSmith endpoint (если используете свой): http://localhost:1984
# LANGSMITH_ENDPOINT=

# LangChain (структурный вывод — JSON-схема Ollama вместо ручного json.loads)
# ВКЛ.: LLM_STRUCTURED_OUTPUT=true. При ошибке модели фолбэк на legacy-парсинг.
LLM_STRUCTURED_OUTPUT=false
